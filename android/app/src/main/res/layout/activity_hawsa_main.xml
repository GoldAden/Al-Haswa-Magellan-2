<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B121B">

    <!-- Scrollable content: header + cards -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="60dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- ===== Header ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="28dp"
                android:paddingBottom="20dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <!-- App title and subtitle on the right (RTL) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:id="@+id/tv_app_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hawsa_app_title"
                        android:textSize="26sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />

                    <TextView
                        android:id="@+id/tv_app_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hawsa_app_subtitle"
                        android:textSize="13sp"
                        android:textColor="#B0B8C8"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <!-- Logo icon on the left (RTL) -->
                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_hawsa_logo"
                    android:contentDescription="@string/hawsa_logo_desc"
                    android:layout_marginStart="12dp" />

            </LinearLayout>

            <!-- ===== 2x2 Card Grid ===== -->
            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Card: الخريطة (Map) - Navy Blue -->
                <FrameLayout
                    android:id="@+id/card_map"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="10dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:background="@drawable/hawsa_card_bg_navy">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:paddingTop="24dp"
                        android:paddingBottom="18dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_hawsa_map"
                            android:contentDescription="@string/hawsa_map_card"
                            android:layout_marginBottom="12dp"
                            app:tint="#FFFFFF" />

                        <!-- Separator line -->
                        <View
                            android:layout_width="40dp"
                            android:layout_height="2dp"
                            android:background="#2A5A8F"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hawsa_map_card"
                            android:textSize="15sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hawsa_map_card_desc"
                            android:textSize="11sp"
                            android:textColor="#A0B8D8"
                            android:gravity="center"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Card: المد والجزر (Tides) - Teal -->
                <FrameLayout
                    android:id="@+id/card_tides"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="10dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:background="@drawable/hawsa_card_bg_teal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:paddingTop="24dp"
                        android:paddingBottom="18dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_hawsa_tides"
                            android:contentDescription="@string/hawsa_tides_card"
                            android:layout_marginBottom="12dp"
                            app:tint="#FFFFFF" />

                        <View
                            android:layout_width="40dp"
                            android:layout_height="2dp"
                            android:background="#2A8F7A"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hawsa_tides_card"
                            android:textSize="15sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hawsa_tides_card_desc"
                            android:textSize="11sp"
                            android:textColor="#A0D8C8"
                            android:gravity="center"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Card: معلومات القمر (Moon) - Purple -->
                <FrameLayout
                    android:id="@+id/card_moon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="10dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:background="@drawable/hawsa_card_bg_purple">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:paddingTop="24dp"
                        android:paddingBottom="18dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_hawsa_moon"
                            android:contentDescription="@string/hawsa_moon_card"
                            android:layout_marginBottom="12dp"
                            app:tint="#FFFFFF" />

                        <View
                            android:layout_width="40dp"
                            android:layout_height="2dp"
                            android:background="#6A3AAA"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hawsa_moon_card"
                            android:textSize="15sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hawsa_moon_card_desc"
                            android:textSize="11sp"
                            android:textColor="#C0A0E8"
                            android:gravity="center"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Card: البوصلة والقبلة (Compass) - Gold -->
                <FrameLayout
                    android:id="@+id/card_compass"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="10dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:background="@drawable/hawsa_card_bg_gold_dark">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:paddingTop="24dp"
                        android:paddingBottom="18dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_hawsa_compass"
                            android:contentDescription="@string/hawsa_compass_card"
                            android:layout_marginBottom="12dp"
                            app:tint="#FFFFFF" />

                        <View
                            android:layout_width="40dp"
                            android:layout_height="2dp"
                            android:background="#8B7320"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hawsa_compass_card"
                            android:textSize="15sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hawsa_compass_card_desc"
                            android:textSize="11sp"
                            android:textColor="#D4C08A"
                            android:gravity="center"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ===== Footer pinned to bottom ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:background="#0B121B"
        android:paddingTop="10dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/tv_designer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hawsa_designer_credit"
            android:textSize="11sp"
            android:textColor="#5A6878" />
    </LinearLayout>

</FrameLayout>