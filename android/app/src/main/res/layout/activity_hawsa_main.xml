<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hawsa_main_bg">

    <!-- Scrollable content: header + cards -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="70dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== Header with background image ===== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/hawsa_header"
                    android:contentDescription="@string/hawsa_header_desc" />

                <!-- Dark gradient overlay for text readability -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/hawsa_header_overlay" />

                <!-- Logo + App name above image -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:src="@drawable/ic_hawsa_logo"
                        android:contentDescription="@string/hawsa_logo_desc"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_app_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hawsa_app_title"
                        android:textSize="30sp"
                        android:textColor="#D4AF37"
                        android:textStyle="bold"
                        android:shadowColor="#80000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="4"
                        android:letterSpacing="0.04" />

                    <TextView
                        android:id="@+id/tv_app_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hawsa_app_subtitle"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        android:shadowColor="#80000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:layout_marginTop="4dp" />

                </LinearLayout>
            </FrameLayout>

            <!-- ===== 2x2 Card Grid ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- Card: Map -->
                    <FrameLayout
                        android:id="@+id/card_map"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="6dp"
                        android:foreground="?attr/selectableItemBackground"
                        android:background="@drawable/hawsa_card_bg_gold">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:src="@drawable/ic_hawsa_map"
                                android:contentDescription="@string/hawsa_map_card"
                                android:layout_marginBottom="10dp"
                                app:tint="#D4AF37" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hawsa_map_card"
                                android:textSize="16sp"
                                android:textColor="#D4AF37"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hawsa_map_card_desc"
                                android:textSize="11sp"
                                android:textColor="#FFFFFF"
                                android:gravity="center"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <!-- Navigation chevron -->
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="top|start"
                            android:layout_marginTop="12dp"
                            android:layout_marginStart="12dp"
                            android:src="@drawable/ic_hawsa_chevron"
                            android:contentDescription="open"
                            app:tint="#FFFFFF" />
                    </FrameLayout>

                    <!-- Card: Tides -->
                    <FrameLayout
                        android:id="@+id/card_tides"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="6dp"
                        android:foreground="?attr/selectableItemBackground"
                        android:background="@drawable/hawsa_card_bg_gold">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:src="@drawable/ic_hawsa_tides"
                                android:contentDescription="@string/hawsa_tides_card"
                                android:layout_marginBottom="10dp"
                                app:tint="#D4AF37" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hawsa_tides_card"
                                android:textSize="16sp"
                                android:textColor="#D4AF37"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hawsa_tides_card_desc"
                                android:textSize="11sp"
                                android:textColor="#FFFFFF"
                                android:gravity="center"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="top|start"
                            android:layout_marginTop="12dp"
                            android:layout_marginStart="12dp"
                            android:src="@drawable/ic_hawsa_chevron"
                            android:contentDescription="open"
                            app:tint="#FFFFFF" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- Card: Moon -->
                    <FrameLayout
                        android:id="@+id/card_moon"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="6dp"
                        android:foreground="?attr/selectableItemBackground"
                        android:background="@drawable/hawsa_card_bg_gold">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:src="@drawable/ic_hawsa_moon"
                                android:contentDescription="@string/hawsa_moon_card"
                                android:layout_marginBottom="10dp"
                                app:tint="#D4AF37" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hawsa_moon_card"
                                android:textSize="16sp"
                                android:textColor="#D4AF37"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hawsa_moon_card_desc"
                                android:textSize="11sp"
                                android:textColor="#FFFFFF"
                                android:gravity="center"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="top|start"
                            android:layout_marginTop="12dp"
                            android:layout_marginStart="12dp"
                            android:src="@drawable/ic_hawsa_chevron"
                            android:contentDescription="open"
                            app:tint="#FFFFFF" />
                    </FrameLayout>

                    <!-- Card: Compass -->
                    <FrameLayout
                        android:id="@+id/card_compass"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="6dp"
                        android:foreground="?attr/selectableItemBackground"
                        android:background="@drawable/hawsa_card_bg_gold">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:src="@drawable/ic_hawsa_compass"
                                android:contentDescription="@string/hawsa_compass_card"
                                android:layout_marginBottom="10dp"
                                app:tint="#D4AF37" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hawsa_compass_card"
                                android:textSize="16sp"
                                android:textColor="#D4AF37"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hawsa_compass_card_desc"
                                android:textSize="11sp"
                                android:textColor="#FFFFFF"
                                android:gravity="center"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="top|start"
                            android:layout_marginTop="12dp"
                            android:layout_marginStart="12dp"
                            android:src="@drawable/ic_hawsa_chevron"
                            android:contentDescription="open"
                            app:tint="#FFFFFF" />
                    </FrameLayout>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ===== Footer pinned to bottom ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:background="#0D1B2A"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:elevation="8dp">

        <!-- Thin gold separator line -->
        <View
            android:layout_width="80dp"
            android:layout_height="1dp"
            android:background="#D4AF37"
            android:layout_marginBottom="8dp" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_hawsa_mountain_footer"
            android:contentDescription="mountain"
            android:layout_marginBottom="4dp"
            app:tint="#D4AF37" />

        <TextView
            android:id="@+id/tv_designer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hawsa_designer_credit"
            android:textSize="11sp"
            android:textColor="#D4AF37" />
    </LinearLayout>

</FrameLayout>