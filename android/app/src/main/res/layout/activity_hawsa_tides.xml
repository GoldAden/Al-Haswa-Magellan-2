<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1B2A"
    android:padding="0dp">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="#E60D1B2A">
        android:layoutDirection="rtl">

        <ImageView
            android:id="@+id/btn_tides_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="@string/hawsa_tides_title"
            android:tint="#D4AF37"
            android:padding="4dp" />

        <TextView
            android:id="@+id/tv_tides_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="20sp"
            android:textColor="#D4AF37"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingEnd="36dp" />
    </LinearLayout>

    <!-- Station name -->
    <TextView
        android:id="@+id/tv_station_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#778DA9"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="4dp" />

    <!-- Tide chart -->
    <app.organicmaps.hawsa.TideChartView
        android:id="@+id/tide_chart_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Day selector buttons -->
    <LinearLayout
        android:id="@+id/days_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center"
        android:layoutDirection="rtl" />

    <!-- Weekly summary -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="160dp"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_weekly_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#778DA9"
            android:lineSpacingExtra="4dp" />
    </ScrollView>

    <!-- Designer credit -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="\u062A\u0645 \u062A\u0635\u0645\u064A\u0645 \u0647\u0630\u0627 \u0627\u0644\u062A\u0637\u0628\u064A\u0642 \u0645\u0646 \u0642\u0628\u0644 \u0623\u0635\u064A\u0644 \u0635\u0627\u062F\u0642"
        android:textSize="10sp"
        android:textColor="#415A77"
        android:layout_gravity="center_horizontal"
        android:paddingBottom="8dp" />

</LinearLayout>